      "description": "Schlüssel 1: Öffnet das Frosttor im Lumenbrunnen und damit die Frosthallen."
    },
    {
      "id": "key_ember_key",
      "name_de": "Glutschlüssel",
      "type": "key",
      "granted_at": "ec_04",
      "description": "Schlüssel 2: Öffnet den Kernschacht in den Hohlen Tiefen."
    }
  ],
  "biomes": [
    {
      "id": "lumen_well",
      "name_de": "Lumenbrunnen",
      "is_hub": true,
      "visual_identity": "Zentraler Brunnen-Schacht aus weißem Stein, umgeben von schwebenden Lichtpartikeln. Meta-Ort: Lumen-Währung und Unlock-Baum.",
      "palette_hint": ["#f5f1e6", "#c9d8e8", "#7fa8c9", "#2b3a4a"]
    },
    {
      "id": "aschen_wald",
      "name_de": "Aschewald",
      "is_hub": false,
      "visual_identity": "Dunkler Wald aus toten Eichen mit leuchtenden Sporen. Erste Erkundungszone: Kronenpfade über dem Boden, Wurzelkeller darunter.",
      "palette_hint": ["#1a2418", "#3d5c3a", "#9fd670", "#e8f5c8"]
    },
    {
      "id": "glut_hoehlen",
      "name_de": "Gluthöhlen",
      "is_hub": false,
      "visual_identity": "Vulkanische Kammern mit Lavafällen und Klammbrücken. Schmiedehalle als Herzstück; Hitze-Distortion in der Luft.",
      "palette_hint": ["#241010", "#8c3b2e", "#f28c38", "#ffd9a0"]
    },
    {
      "id": "frost_hallen",
      "name_de": "Frosthallen",
      "is_hub": false,
      "visual_identity": "Gefrorene Palasthallen mit spiegelnden Kuppeln und Eiskathedrale. Stille, klare Linien, Lichtbrechung auf Eisflächen.",
      "palette_hint": ["#0e1c26", "#3a7ca5", "#9fd8ef", "#f0fbff"]
    },
    {
      "id": "hohle_tiefen",
      "name_de": "Hohle Tiefen",
      "is_hub": false,
      "visual_identity": "Der Kernschacht unter der Welt: Lumenadern leuchten in purpurnem Gestein. Finale Zone um den Lumenkern.",
      "palette_hint": ["#140f24", "#4a3d78", "#9b7fd4", "#ffe9a0"]
    }
  ],
