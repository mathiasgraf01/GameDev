      "description": "Zweiter Sprung in der Luft. Öffnet den Kronenpfad im Aschewald."
    },
    {
      "id": "ability_dash",
      "name_de": "Glutdash",
      "type": "movement",
      "granted_at": "ag_05",
      "description": "Kurzer, schneller Sprung nach vorn. Durchbricht Dornen und schmale Lücken."
    },
    {
      "id": "ability_wall_slide",
      "name_de": "Wandgleiten",
      "type": "movement",
      "granted_at": "ec_02",
      "description": "Gleiten an Wänden, um Klammen und Abgründe zu überwinden."
    },
    {
      "id": "ability_light_step",
      "name_de": "Lichtschritt",
      "type": "movement",
      "granted_at": "hd_02",
      "description": "Gehen auf Lichtplattformen und durch dunkle Schächte, ohne zu fallen."
    },
    {
      "id": "key_lumen_shard",
      "name_de": "Lumen-Splitter",
      "type": "key",
