{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lumenfall/balance/stats.schema.json",
  "title": "Lumenfall — Stat-Vokabular (T-003)",
  "description": "Definiert die erlaubten Stat-Keys, ihre Semantik und Wertebereiche. Referenziert von items.json (base_stats) und affixes.json (stat_key). Alle anderen Schemas müssen dieselbe Key-Menge verwenden (geprüft in tests/test_balance_refs.py).",
  "type": "object",
  "properties": {
    "max_hp": {
      "type": "integer",
      "minimum": 5,
      "maximum": 100,
      "description": "Zusätzliche maximale Lebenspunkte (flat)."
    },
    "attack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Zusätzlicher Basisangriff (flat)."
    },
    "defense": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "Zusätzliche Verteidigung (flat); reduziert eingehenden Schaden."
    },
    "speed": {
      "type": "number",
      "minimum": -50,
      "maximum": 50,
      "description": "Bewegungs-/Aktionsgeschwindigkeit in % des Basiswerts."
    },
    "crit_chance": {
      "type": "number",
      "minimum": 0,
      "maximum": 30,
      "description": "Kritische-Treffer-Chance in Prozentpunkten (flat)."
    },
    "crit_damage": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "Zusätzlicher Kritschaden in % des Basis-Kritmultiplikators."
    },
    "lumen_gain": {
      "type": "number",
      "minimum": 0,
      "maximum": 20,
      "description": "Bonus auf Lumen-Ertrag in Prozent (Meta-Währung, GDD-Pillar 1)."
    }
  },
  "additionalProperties": false
}
