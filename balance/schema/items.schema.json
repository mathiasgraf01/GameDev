{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lumenfall/balance/items.schema.json",
  "title": "Lumenfall — items.json (T-003)",
  "type": "object",
  "required": ["meta", "items"],
  "properties": {
    "meta": {"type": "object"},
    "items": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "name_de", "slot", "rarity", "base_stats", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^item_[waz]_[a-z0-9]+(_[a-z0-9]+)*$",
            "description": "Präfix: w=Waffe, a=Rüstung, z=Accessoire."
          },
          "name_de": {"type": "string", "minLength": 2},
          "slot": {"enum": ["weapon", "armor", "accessory"]},
          "rarity": {"enum": ["common", "uncommon", "rare", "epic"]},
          "base_stats": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "description": "Feste Item-Werte. Key-Menge muss identisch mit stats.schema.json sein.",
            "properties": {
              "max_hp": {"type": "integer", "minimum": 5, "maximum": 100},
              "attack": {"type": "integer", "minimum": 1, "maximum": 20},
              "defense": {"type": "integer", "minimum": 1, "maximum": 15},
              "speed": {"type": "number", "minimum": -50, "maximum": 50},
              "crit_chance": {"type": "number", "minimum": 0, "maximum": 30},
              "crit_damage": {"type": "number", "minimum": 0, "maximum": 50},
              "lumen_gain": {"type": "number", "minimum": 0, "maximum": 20}
            }
          },
          "affixes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^affix_[a-z0-9]+(_[a-z0-9]+)*$"
            },
            "description": "Affix-IDs aus affixes.json. Anzahl pro Rarity: common 0-1, uncommon 1-2, rare 2-3, epic 3-4 (geprüft in tests/test_balance.py)."
          },
          "source": {
            "type": "string",
            "minLength": 2,
            "description": "Biome-ID oder Boss-ID aus world/map_graph.json (oder 'any')."
          },
          "description_de": {"type": "string"}
        }
      }
    }
  }
}
