{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lumenfall/balance/drops.schema.json",
  "title": "Lumenfall — drops.json (T-003)",
  "type": "object",
  "required": ["meta", "tables"],
  "properties": {
    "meta": {"type": "object"},
    "tables": {
      "type": "array",
      "minItems": 7,
      "description": "Mindestens eine Tabelle pro Biome (5) und pro Boss (2).",
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "entries"],
        "properties": {
          "source_id": {
            "type": "string",
            "description": "Biome-ID oder Boss-ID aus world/map_graph.json (geprüft in tests/test_balance_refs.py)."
          },
          "source_type": {"enum": ["biome", "boss"]},
          "guaranteed": {
            "type": "boolean",
            "default": false,
            "description": "true = Boss-Drop: genau ein Eintrag wird garantiert gewürfelt (Wahrscheinlichkeiten werden renormiert)."
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["item_id", "probability"],
              "properties": {
                "item_id": {"type": "string", "pattern": "^item_[waz]_[a-z0-9]+(_[a-z0-9]+)*$"},
                "probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            },
            "description": "Summe der Wahrscheinlichkeiten pro Tabelle <= 1.0 (Rest = kein Drop). Geprüft in tests/test_balance.py."
          }
        }
      }
    }
  }
}
